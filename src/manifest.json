{
  "manifest_version": 3,
  "name": "LinkedIn Rich Text Shortcuts",
  "version": "2.0.0",
  "description": "Enables native bold text formatting (Ctrl+B / Cmd+B) in LinkedIn post and comment editors.",
  "author": "LinkedIn Rich Text Shortcuts",
  "homepage_url": "https://bhanubais.github.io/bold-text-on-linkedin/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "LinkedIn Rich Text Shortcuts"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
